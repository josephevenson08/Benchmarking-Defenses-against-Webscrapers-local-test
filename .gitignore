# Dependencies
node_modules/
.venv/
__pycache__/

# Generated by site/generate.js (rebuild with: npm run generate -- <condition>)
# Root folder only: the copies in results/<date>/conditions/ hold each experiment's seeds and are committed.
/conditions/

# Request logs from site/server.js (default logs/requests.jsonl)
# Root folder only: results/<date>/logs/ holds each experiment's request logs and is committed.
/logs/

# Practice scraper outputs while developing (real experiment results go in dated folders)
results/dev/
